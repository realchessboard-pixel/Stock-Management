# PostgreSQL connection string (server-only; never prefix with NEXT_PUBLIC_)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/stockflow"
# Separate database used by the integration test suite (it is wiped between tests)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/stockflow_test"
# 32+ random chars, used as a pepper when hashing session tokens: openssl rand -base64 48
SESSION_SECRET=""
# Public origin of the app, used for CSRF origin checks behind proxies
APP_URL="http://localhost:3000"
